{
  "schemaVersion": 2,
  "datasetName": "LoL Esports Historical Peaks",
  "description": "Real player identities, organizations, seasons and tournament achievements. Balance attributes are curated estimates, not official Riot statistics. Includes notable European and North American international runs, with the complete G2 Esports 2019 starting roster.",
  "methodology": {
    "factualFields": [
      "nickname",
      "team",
      "year",
      "position",
      "region",
      "achievement"
    ],
    "derivedFields": [
      "mechanics",
      "consistency",
      "experience",
      "teamwork",
      "team rating"
    ],
    "ratingScale": "0-100",
    "note": "Peak snapshots are selected from notable international seasons. Scores are editorial game-balance values informed by achievement and historical performance."
  },
  "sources": [
    {
      "name": "Leaguepedia World Championship",
      "url": "https://lol.fandom.com/wiki/World_Championship",
      "use": "Worlds winners, finalists, MVPs, rosters and player timelines"
    },
    {
      "name": "Liquipedia World Championships",
      "url": "https://liquipedia.net/leagueoflegends/World_Championships",
      "use": "Tournament results and historical cross-checking"
    },
    {
      "name": "Oracle's Elixir",
      "url": "https://oracleselixir.com/tools/downloads",
      "use": "Historical match datasets and performance analysis from 2015 onward"
    },
    {
      "name": "Games of Legends",
      "url": "https://gol.gg/esports/home/",
      "use": "Tournament and player-stat cross-checking"
    },
    {
      "name": "G2 Esports MSI 2019 winners announcement",
      "url": "https://g2esports.com/blogs/news/we-are-the-msi-2019-winners",
      "use": "G2 2019 starting roster and MSI title"
    },
    {
      "name": "MSI 2019 Team Rosters",
      "url": "https://lol.fandom.com/wiki/2019_Mid-Season_Invitational/Main_Event/Team_Rosters",
      "use": "G2 and Team Liquid 2019 roster cross-check"
    },
    {
      "name": "Fnatic 2018 Statistics",
      "url": "https://lol.fandom.com/wiki/Fnatic/Statistics/2018",
      "use": "Fnatic 2018 player and tournament cross-check"
    },
    {
      "name": "Cloud9 2018 Worlds Statistics",
      "url": "https://gol.gg/teams/team-stats/399/split-ALL/tournament-World%20Championship%202018/",
      "use": "Cloud9 2018 Worlds lineup and performance"
    },
    {
      "name": "MSI 2016",
      "url": "https://lol.fandom.com/wiki/2016_Mid-Season_Invitational",
      "use": "Counter Logic Gaming runner-up result"
    },
    {
      "name": "Worlds 2016",
      "url": "https://liquipedia.net/leagueoflegends/World_Championship/2016",
      "use": "H2K semifinal result"
    }
  ],
